# Public Privy application identifier. Safe to expose client-side.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional public RPC endpoint for Base. Leave blank to use the chain's default public transport.
NEXT_PUBLIC_BASE_RPC_URL=

# Optional sandbox casino API base URL. Example: https://sandbox-casino.example.com
# Keep this server-side. Skooby maps its /api/game/* routes to the provider contract.
CASINO_API_BASE_URL=

# Optional server-side sandbox bearer token if your test provider requires one.
CASINO_API_TOKEN=

# If the sandbox provider is unavailable, use the built-in play-credit engine.
CASINO_ALLOW_DEMO_FALLBACK=true

# Optional external provider handoff. When configured, Skooby can send users to the provider's own site.
# Any account funding, withdrawals, custody, or regulated gaming activity remains entirely with that provider.
CASINO_PUBLIC_LAUNCH_URL=
CASINO_PROVIDER_NAME=

# Never place Privy app secrets, private keys, seed phrases, casino credentials, or signing credentials in NEXT_PUBLIC_* variables.
