# Public Privy application identifier. Safe to expose client-side.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy's ES256 public verification key from the Privy dashboard.
# Server-only. Used to validate access-token signature, issuer, audience and expiry.
PRIVY_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional public RPC endpoint for Base. Leave blank to use the chain's default public transport.
NEXT_PUBLIC_BASE_RPC_URL=

# External provider launch URL. The hostname must ALSO exist in the hardcoded allowlist
# in lib/casino-security.ts or the handoff is rejected.
NEXT_PUBLIC_CASINO_PROVIDER_URL=

# Short-lived handoff JWT signing secret. Use at least 32 random characters.
CASINO_SESSION_SIGNING_SECRET=

# HMAC secret used to verify x-skooby-signature on provider webhooks.
CASINO_WEBHOOK_SECRET=

# Upstash Redis REST credentials. This is the authoritative play-credit database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional sandbox game API. External API responses cannot directly mutate play credits;
# signed provider webhooks are the only external balance-update path.
CASINO_API_BASE_URL=
CASINO_API_TOKEN=
CASINO_ALLOW_DEMO_FALLBACK=true

# Optional provider display metadata.
CASINO_PROVIDER_NAME=

# Never place Privy app secrets, Redis tokens, webhook secrets, private keys,
# seed phrases, or signing credentials in NEXT_PUBLIC_* variables.
